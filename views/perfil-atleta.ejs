<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= atleta.nome %> - Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/navbar') %>

    <main class="container perfil-container">

        <!-- Cabeçalho do perfil -->
        <section class="perfil-header">

            <div class="perfil-identificacao">

                <div class="perfil-avatar">
                    <% if (atleta.foto_perfil) { %>
                        <img
                            src="<%= atleta.foto_perfil %>"
                            alt="Foto de perfil de <%= atleta.nome %>"
                        >
                    <% } else { %>
                        <%= atleta.nome.charAt(0).toUpperCase() %>
                    <% } %>
                </div>

                <div>
                    <h1 class="perfil-nome">
                        <%= atleta.nome %>
                    </h1>

                    <p class="perfil-subtitulo">
                        Atleta Sportune
                    </p>
                </div>

            </div>

            <div class="perfil-tags">
                <span class="perfil-tag">
                    <%= atleta.esporte %>
                </span>

                <span class="perfil-tag">
                    <%= atleta.pais %>
                </span>
            </div>

        </section>
        <!-- Informações de seguidores -->
<div class="perfil-conexoes">

    <div>
        <strong><%= quantidadeSeguidores %></strong>
        <span>Seguidores</span>
    </div>

    <div>
        <strong><%= quantidadeSeguindo %></strong>
        <span>Seguindo</span>
    </div>

</div>

<!-- Botão de seguir -->
<% if (usuario && !ehMeuPerfil) { %>

    <form
        action="/seguidores/<%= atleta.id %>/alternar"
        method="POST"
        class="perfil-seguir-form"
    >
    <button
    type="submit"
    class="perfil-seguir-btn <%= usuarioSegueAtleta ? 'seguindo' : '' %>"
>
    <%= usuarioSegueAtleta ? 'Deixar de seguir' : 'Seguir' %>
</button>
    </form>

<% } %>
        

        <!-- Biografia -->
        <section class="perfil-secao">

            <h2>Sobre mim</h2>

            <% if (atleta.bio) { %>

                <p class="perfil-bio"><%= atleta.bio %></p>

            <% } else { %>

                <p class="perfil-vazio">
                    Este atleta ainda não adicionou uma biografia.
                </p>

            <% } %>

        </section>

        <!-- Experiências -->
        <section class="perfil-secao">

            <h2>Experiência esportiva</h2>

            <p class="perfil-vazio">
                As experiências esportivas deste atleta aparecerão aqui.
            </p>

        </section>

        <!-- Conquistas -->
        <section class="perfil-secao">

            <h2>Conquistas</h2>

            <p class="perfil-vazio">
                As conquistas deste atleta aparecerão aqui.
            </p>

        </section>

    </main>

</body>
</html>