<!DOCTYPE html>

<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Meu Perfil - Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="container text-center mt-5">

        <h1>Meu Perfil</h1>

<p class="lead mt-3">
    Bem-vindo, <%= usuario.nome %>!
</p>

<div class="card mt-4">
    <div class="card-body">

        <p>
            <strong>Tipo de usuário:</strong> <%= tipo %>
        </p>

        <p>
            <strong>Email:</strong> <%= usuario.email %>
        </p>

        <p>
            <strong>Esporte:</strong> <%= usuario.esporte %>
        </p>

        <p>
            <strong>País:</strong> <%= usuario.pais %>
        </p>

        <% if (tipo === 'treinador') { %>

            <p>
                <strong>Experiência:</strong> <%= usuario.experiencia %>
            </p>

        <% } %>

    </div>
</div>
    </div>

</body>

</html>