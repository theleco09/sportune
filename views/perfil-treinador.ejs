<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= treinador.nome %> - Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/navbar') %>

    <main class="container perfil-container">

        <!-- Cabeçalho do perfil -->
        <section class="perfil-header">

            <div class="perfil-identificacao">

                <div class="perfil-avatar">
                    <%= treinador.nome.charAt(0).toUpperCase() %>
                </div>

                <div>
                    <h1 class="perfil-nome">
                        <%= treinador.nome %>
                    </h1>

                    <p class="perfil-subtitulo">
                        Treinador Sportune
                    </p>
                </div>

            </div>

            <div class="perfil-tags">

                <span class="perfil-tag">
                    <%= treinador.esporte %>
                </span>

                <span class="perfil-tag">
                    <%= treinador.pais %>
                </span>

            </div>

        </section>

        <!-- Biografia -->
        <section class="perfil-secao">

            <h2>Sobre mim</h2>

            <% if (treinador.bio) { %>

                <p class="perfil-bio"><%= treinador.bio %></p>

            <% } else { %>

                <p class="perfil-vazio">
                    Este treinador ainda não adicionou uma biografia.
                </p>

            <% } %>

        </section>

        <!-- Experiência profissional -->
        <section class="perfil-secao">

            <h2>Experiência profissional</h2>

            <% if (treinador.experiencia) { %>

                <p class="perfil-bio"><%= treinador.experiencia %></p>

            <% } else { %>

                <p class="perfil-vazio">
                    Este treinador ainda não informou sua experiência profissional.
                </p>

            <% } %>

        </section>

        <!-- Histórico profissional -->
        <section class="perfil-secao">

            <h2>Histórico profissional</h2>

            <p class="perfil-vazio">
                As experiências profissionais deste treinador aparecerão aqui.
            </p>

        </section>

        <!-- Conquistas -->
        <section class="perfil-secao">

            <h2>Conquistas</h2>

            <p class="perfil-vazio">
                As conquistas deste treinador aparecerão aqui.
            </p>

        </section>

    </main>

</body>
</html>