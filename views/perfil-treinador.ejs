<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= treinador.nome %> - Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="container mt-5">

        <h1>
            <%= treinador.nome %>
        </h1>

        <div class="card mt-4">
            <div class="card-body">

                <h5 class="card-title">
                    Perfil do treinador
                </h5>

                <p class="card-text">
                    Esporte: <%= treinador.esporte %>
                </p>

                <p class="card-text">
                    País: <%= treinador.pais %>
                </p>

            </div>
        </div>

    </div>

</body>
</html>