
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed esportivo | Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/navbar') %>

    <main class="container py-4">
        <section class="feed-container">

            <header class="feed-intro">
                <h1 class="h3 mb-2">Feed esportivo</h1>
                <p class="mb-0">
                    Sua jornada, suas conquistas, seu esporte.
                </p>
            </header>

            <% if (usuario) { %>
                <form action="/feed" method="POST" class="card feed-form">
                    <div class="card-body p-3">
                        <label for="conteudo" class="form-label fw-semibold">
                            Compartilhe sua jornada
                        </label>

                        <textarea
                            id="conteudo"
                            name="conteudo"
                            class="form-control mb-3"
                            rows="3"
                            maxlength="1000"
                            placeholder="Qual foi sua conquista de hoje?"
                            required
                        ></textarea>

                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <small class="text-muted">
                                Até 1.000 caracteres
                            </small>

                            <button type="submit" class="btn btn-primary">
                                Publicar
                            </button>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <div class="card feed-form">
                    <div class="card-body">
                        <p class="mb-2">
                            Faça parte da comunidade esportiva.
                        </p>

                        <a href="/login" class="btn btn-primary">
                            Entrar para publicar
                        </a>
                    </div>
                </div>
            <% } %>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 mb-0">Publicações recentes</h2>

                <span class="feed-meta">
                    <%= publicacoes.length %>
                    <%= publicacoes.length === 1 ? 'publicação' : 'publicações' %>
                </span>
            </div>

            <% if (publicacoes.length === 0) { %>
                <div class="feed-empty">
                    <p class="mb-2">Ainda não há publicações.</p>
                    <span>Seja o primeiro a compartilhar uma conquista!</span>
                </div>
            <% } %>

            <% publicacoes.forEach(publicacao => { %>
                <article class="card feed-post">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="feed-avatar">
                                <%= (publicacao.usuarios?.nome || 'A')
                                    .trim().charAt(0).toUpperCase() %>
                            </div>

                            <div class="flex-grow-1">
                                <h3 class="feed-author">
                                    <%= publicacao.usuarios?.nome || 'Atleta' %>
                                </h3>

                                <div class="feed-meta">
                                    <%= new Date(publicacao.criado_em)
                                        .toLocaleString('pt-BR') %>
                                </div>
                            </div>

                            <span class="badge text-bg-primary">Sportune</span>
                        </div>

                        <p class="feed-content mb-0"><%= publicacao.conteudo %></p>
                    </div>
                </article>
            <% }) %>

        </section>
    </main>
</body>
</html>
