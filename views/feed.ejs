
<main class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">Feed esportivo</h1>
        <p class="text-muted">
            Compartilhe suas conquistas e acompanhe outros atletas.
        </p>
    </div>

    <% if (usuario) { %>
        <form action="/feed" method="POST" class="card card-body shadow-sm mb-4">
            <label for="conteudo" class="form-label fw-bold">
                O que você conquistou?
            </label>

            <textarea
                id="conteudo"
                name="conteudo"
                class="form-control mb-3"
                rows="4"
                maxlength="1000"
                placeholder="Conte sua novidade esportiva..."
                required
            ></textarea>

            <button type="submit" class="btn btn-success align-self-start">
                Publicar
            </button>
        </form>
    <% } else { %>
        <div class="alert alert-light border">
            <a href="/login">Entre na sua conta</a> para compartilhar suas conquistas.
        </div>
    <% } %>

    <h2 class="h4 mb-3">Publicações recentes</h2>

    <% if (publicacoes.length === 0) { %>
        <div class="alert alert-light border">
            Ainda não há publicações. Seja o primeiro a compartilhar uma conquista!
        </div>
    <% } %>

    <div class="row g-4">
        <% publicacoes.forEach(publicacao => { %>
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-success mb-3">Sportune</span>

                        <h3 class="h5">
                            <%= publicacao.usuarios?.nome || 'Atleta' %>
                        </h3>

                        <p class="card-text"><%= publicacao.conteudo %></p>

                        <p class="text-muted small mb-0">
                            <%= new Date(publicacao.criado_em).toLocaleString('pt-BR') %>
                        </p>
                    </div>
                </article>
            </div>
        <% }) %>
    </div>
</main>

