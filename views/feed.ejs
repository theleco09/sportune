
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed esportivo | Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/navbar') %>

    <main class="container py-4">
        <section class="feed-container">

            <header class="feed-intro">
                <span class="feed-label">
                    <span class="feed-indicator"></span>
                    COMUNIDADE SPORTUNE
                </span>
            
                <h1 class="mt-3">
                    O esporte conecta. <span>Sua jornada inspira.</span>
                </h1>
            
                <p class="mb-0">
                    Compartilhe conquistas, acompanhe atletas e faça parte
                    de uma comunidade que vive o esporte.
                </p>
            </header>

            <% if (usuario) { %>
                <form action="/feed" method="POST" class="card feed-form">
                    <div class="card-body p-3">
                        <label for="conteudo" class="form-label fw-semibold">
                            Compartilhe sua jornada
                        </label>

                        <textarea
                            id="conteudo"
                            name="conteudo"
                            class="form-control mb-3"
                            rows="3"
                            maxlength="1000"
                            placeholder="Qual foi sua conquista de hoje?"
                            required
                        ></textarea>

                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <small class="text-muted">
                                Até 1.000 caracteres
                            </small>

                            <button type="submit" class="btn btn-primary">
                                Publicar
                            </button>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <div class="card feed-form">
                    <div class="card-body">
                        <p class="mb-2">
                            Faça parte da comunidade esportiva.
                        </p>

                        <a href="/login" class="btn btn-primary">
                            Entrar para publicar
                        </a>
                    </div>
                </div>
            <% } %>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 mb-0">Publicações recentes</h2>

                <span class="feed-meta">
                    <%= publicacoes.length %>
                    <%= publicacoes.length === 1 ? 'publicação' : 'publicações' %>
                </span>
            </div>

            <% if (publicacoes.length === 0) { %>
                <div class="feed-empty">
                    <p class="mb-2">Ainda não há publicações.</p>
                    <span>Seja o primeiro a compartilhar uma conquista!</span>
                </div>
            <% } %>

            <% publicacoes.forEach(publicacao => { %>
                <article class="card feed-post">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="feed-avatar">
                                <%= (publicacao.usuarios?.nome || 'A')
                                    .trim().charAt(0).toUpperCase() %>
                            </div>

                            <div class="flex-grow-1">
                                <h3 class="feed-author">
                                    <%= publicacao.usuarios?.nome || 'Atleta' %>
                                </h3>

                                <div class="feed-meta">
                                    <%= new Date(publicacao.criado_em)
                                        .toLocaleString('pt-BR') %>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <span class="feed-badge">SPORTUNE</span>
                            
                                <% if (usuario && usuario.id === publicacao.usuario_id) { %>
                                    <form
                                        action="/feed/<%= publicacao.id %>/excluir"
                                        method="POST"
                                        onsubmit="return confirm('Tem certeza que deseja excluir esta publicação?');"
                                    >
                                        <button type="submit" class="feed-delete">
                                            Excluir
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>

                        <div class="feed-divider"></div>
                        
                        <p class="feed-content mb-0"><%= publicacao.conteudo %></p>
                        <div class="feed-actions">
                            <% if (usuario) { %>
                                <form action="/feed/<%= publicacao.id %>/curtir" method="POST">
                                    <button type="submit" class="feed-like <%= publicacao.usuarioCurtiu ? 'liked' : '' %>">
                                        <span><%= publicacao.usuarioCurtiu ? '♥' : '♡' %></span>
                                        <%= publicacao.usuarioCurtiu ? 'Curtido' : 'Curtir' %>
                                        · <%= publicacao.quantidadeCurtidas %>
                                    </button>
                                </form>
                            <% } else { %>
                                <a href="/login" class="feed-like">
                                    ♡ Curtir · <%= publicacao.quantidadeCurtidas %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                    <div class="feed-comments">

                        <h4>Comentários (<%= publicacao.comentarios.length %>)</h4>
                    
                        <% publicacao.comentarios.forEach(comentario => { %>
                            <div class="feed-comment">
                                <strong><%= comentario.usuarios.nome %></strong>
                                <p><%= comentario.conteudo %></p>
                            </div>
                        <% }) %>
                    
                        <% if (usuario) { %>
                            <form
                                action="/feed/<%= publicacao.id %>/comentar"
                                method="POST"
                                class="feed-comment-form"
                            >
                                <input
                                    type="text"
                                    name="conteudo"
                                    placeholder="Escreva um comentário..."
                                    maxlength="500"
                                    required
                                >
                    
                                <button type="submit">Enviar</button>
                            </form>
                        <% } else { %>
                            <a href="/login">Entre para comentar</a>
                        <% } %>
                    
                    </div>
                </article>
            <% }) %>

        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
