<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Perfil - Sportune</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="container mt-5">

        <h1>Editar Perfil</h1>

        <% if (erro) { %>
            <div class="alert alert-danger">
                <%= erro %>
            </div>
        <% } %>

        <form action="/perfil/editar" method="POST">

            <div class="mb-3">
                <label class="form-label">Nome</label>
                <input
                    type="text"
                    name="nome"
                    class="form-control"
                    value="<%= usuario.nome %>"
                >
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input
                    type="email"
                    name="email"
                    class="form-control"
                    value="<%= usuario.email %>"
                >
            </div>

            <div class="mb-3">
                <label class="form-label">Esporte</label>
                <input
                    type="text"
                    name="esporte"
                    class="form-control"
                    value="<%= usuario.esporte %>"
                >
            </div>

            <div class="mb-3">
                <label class="form-label">País</label>
                <input
                    type="text"
                    name="pais"
                    class="form-control"
                    value="<%= usuario.pais %>"
                >
            </div>

            <% if (tipo === 'treinador') { %>

                <div class="mb-3">
                    <label class="form-label">Experiência</label>
                    <input
                        type="text"
                        name="experiencia"
                        class="form-control"
                        value="<%= usuario.experiencia %>"
                    >
                </div>

            <% } %>

            <button type="submit" class="btn btn-primary">
                Salvar alterações
            </button>

        </form>

    </div>

</body>
</html>