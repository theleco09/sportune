<!DOCTYPE html>

<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sportune</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

</head>

<body>

<%- include('partials/navbar') %>

<div class="container text-center mt-5">

    <h1 class="display-3 fw-bold">
        Sportune
    </h1>

    <p class="lead mt-3">
        Conectando atletas e treinadores ao redor do mundo.
    </p>

    <p class="mt-4">
        Encontre novas oportunidades, conheça pessoas
        e por dentro do mundo esportivo.
    </p>

    <a href="/jornada" class="btn btn-primary btn-lg mt-3">
        Comece sua jornada
    </a>
    <div class="row justify-content-center mt-5">

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">
                        Atletas
                    </h2>
    
                    <p class="card-text mt-3">
                        Conheça os atletas que fazem parte do Sportune.
                    </p>
    
                    <a href="/atletas" class="btn btn-outline-primary">
                        Ver atletas
                    </a>
                </div>
            </div>
        </div>
    
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">
                        Treinadores
                    </h2>
    
                    <p class="card-text mt-3">
                        Conheça os treinadores que fazem parte do Sportune.
                    </p>
    
                    <a href="/treinadores" class="btn btn-outline-primary">
                        Ver treinadores
                    </a>
                </div>
            </div>
        </div>
    
    </div>

</div>

</body>

</html>
